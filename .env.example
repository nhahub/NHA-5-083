# =============================================================================
# Global Restaurant Explorer: environment variable catalogue
# =============================================================================
# Copy to `.env` for local development and fill in real values.
# Never commit `.env` (it is git-ignored). Never put a real secret in this file.
#
# This file lists ONLY secrets and environment-specific values.
# Tunable, non-secret settings (timeouts, limits, thresholds, schedules,
# dataset identifiers, paths) live in `config/settings.toml`.
# Full rules: docs/SECRETS.md
#
# Any key in config/settings.toml can be overridden here with SECTION_KEY,
# for example NLP_TIMEOUT_SECONDS=8. Use overrides sparingly.
# =============================================================================

# local | ci | production
APP_ENV=local


# -----------------------------------------------------------------------------
# MySQL connection (pipeline and backend)
# -----------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_HOST_PORT=3306
MYSQL_DATABASE=global_restaurant_explorer
MYSQL_ROOT_PASSWORD=replace_with_local_mysql_root_password
# TRUE in production (Azure Flexible Server requires TLS)
MYSQL_TLS_ENABLED=FALSE

# Application account: read-only, used by the FastAPI backend
MYSQL_APP_USER=replace_with_app_username
MYSQL_APP_PASSWORD=replace_with_app_password

# Pipeline account: writes Silver and Gold, used by pipeline modules and Airflow
MYSQL_PIPELINE_USER=replace_with_pipeline_username
MYSQL_PIPELINE_PASSWORD=replace_with_pipeline_password


# -----------------------------------------------------------------------------
# Source credentials (pipeline)
# -----------------------------------------------------------------------------
# Kaggle API, used to fetch the Zomato dataset (docs/DATA_SOURCES.md)
KAGGLE_USERNAME=replace_with_kaggle_username
KAGGLE_KEY=replace_with_kaggle_api_key

# FX rate provider for USD standardization (provider chosen during implementation;
# leave blank if the chosen provider needs no key)
FX_RATE_API_KEY=


# -----------------------------------------------------------------------------
# Bronze storage (pipeline)
# -----------------------------------------------------------------------------
# local | azure
STORAGE_BACKEND=local
# Used when STORAGE_BACKEND=azure
AZURE_STORAGE_ACCOUNT_URL=https://replace_account.blob.core.windows.net
AZURE_STORAGE_CONNECTION_STRING=replace_with_connection_string


# -----------------------------------------------------------------------------
# Hugging Face Inference (backend)
# -----------------------------------------------------------------------------
HF_API_KEY=replace_with_huggingface_api_key


# -----------------------------------------------------------------------------
# FastAPI backend
# -----------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated allowlist; the Streamlit app URL in production
BACKEND_CORS_ORIGINS=http://localhost:8501


# -----------------------------------------------------------------------------
# Streamlit app (holds NO database credentials)
# -----------------------------------------------------------------------------
STREAMLIT_BACKEND_URL=http://127.0.0.1:8000


# -----------------------------------------------------------------------------
# Apache Airflow (local Docker)
# -----------------------------------------------------------------------------
# Linux or WSL2 host UID for volume ownership (`id -u`)
AIRFLOW_UID=50000

# Airflow metadata database (local Docker only)
AIRFLOW_PG_USER=airflow
AIRFLOW_PG_PASSWORD=replace_with_local_postgres_password
AIRFLOW_PG_DB=airflow

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=replace_with_generated_fernet_key
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
AIRFLOW_JWT_SECRET=replace_with_random_jwt_secret

# Airflow connections. docker-compose.yml composes these from the values above,
# so you normally do not set them here. Set them directly only when running
# Airflow without docker-compose. (docs/SECRETS.md, section 7)
# AIRFLOW_CONN_MYSQL_PIPELINE={"conn_type": "mysql", "host": "...", "port": 3306, "schema": "...", "login": "...", "password": "..."}
# AIRFLOW_CONN_AZURE_BLOB_BRONZE={"conn_type": "wasb", "extra": {"connection_string": "..."}}


# -----------------------------------------------------------------------------
# Azure Key Vault (production reference only; not used locally)
# -----------------------------------------------------------------------------
# In production, App Service and the Airflow VM receive the secrets above as
# environment variables resolved from Key Vault. Application code never calls
# Key Vault directly.
AZURE_KEY_VAULT_URL=https://replace_vault_name.vault.azure.net
